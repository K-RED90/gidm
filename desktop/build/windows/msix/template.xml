<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="gidm-desktop"
        Arguments=""
        InstallLocation="C:\Program Files\gidm">
    </Installer>
    <PackageInformation
        PackageName="gidm"
        PackageDisplayName="gidm"
        PublisherName="CN=gidm"
        PublisherDisplayName="gidm"
        Version="0.1.0.0"
        PackageDescription="Open-source download accelerator — segmented, parallel downloads.">
        <Capabilities>
            <Capability Name="runFullTrust" />

        </Capabilities>
        <Applications>
            <Application
                Id="gidm"
                Description="Open-source download accelerator — segmented, parallel downloads."
                DisplayName="gidm"
                ExecutableName="gidm-desktop"
                EntryPoint="Windows.FullTrustApplication">

            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>gidm</DisplayName>
            <PublisherDisplayName>gidm</PublisherDisplayName>
            <Description>Open-source download accelerator — segmented, parallel downloads.</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="gidm-desktop.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
